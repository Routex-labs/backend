# 로컬 실행용 접속 정보. 이 파일을 .env로 복사해 값을 채운다(.env는 커밋되지 않는다).
#   cp .env.example .env
# application.yml의 spring.config.import가 .env를 읽는다. 없으면 그냥 무시한다.
# Cloud Run에는 이 값들을 환경변수로 준다(SPRING_DATASOURCE_URL 형태).

# --- Supabase(운영과 같은 DB에 붙을 때) ---------------------------------------
# Supabase 대시보드 > Connect > "Session pooler" 문자열을 쓴다.
# Direct connection은 IPv6라 Cloud Run에서 안 붙는다 - 로컬도 같은 걸로 통일한다.
# 유저명에 프로젝트 ref가 붙는 것이 pooler 규칙이다(빼면 인증 실패).
spring.datasource.url=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
spring.datasource.username=postgres.<project-ref>
spring.datasource.password=

# Cloud Run 인스턴스가 최대 20개까지 늘어난다. 인스턴스당 10개(기본)면 무료 티어
# 연결 상한에 닿는다. 읽기 위주에 트래픽도 작아 3이면 충분하다.
spring.datasource.hikari.maximum-pool-size=3

# Supabase에 붙을 때는 반드시 꺼라. 켜져 있으면 spring-boot-docker-compose가
# 로컬 컨테이너를 띄우고 접속 정보를 여기 값보다 우선해 덮어쓴다 - 붙었다고
# 착각한 채 계속 로컬 PG를 보게 된다.
spring.docker.compose.enabled=false

# --- 로컬 compose PostgreSQL(기본 개발 경로) ----------------------------------
# 위 넷을 지우거나 주석 처리하면 compose.yaml이 자동으로 뜨고 접속 정보도 자동이다.
# compose 없이 직접 띄운 PG에 붙을 때만 아래를 쓴다.
#spring.datasource.url=jdbc:postgresql://localhost:5432/navigation
#spring.datasource.username=navigation
#spring.datasource.password=navigation
